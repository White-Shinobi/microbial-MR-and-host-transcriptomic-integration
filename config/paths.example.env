# Copy this file to .env and edit only the local copy.
export PROJECT_ROOT="$(pwd)"
export LDSC_PYTHON="python3"
export LDSC_HOME="/path/to/ldsc"
export LDSC_PYDEPS=""
export LDSC_LD_REFERENCE="/path/to/eur_w_ld_chr"
export PLINK_BIN="/path/to/plink"
export LD_REFERENCE_PREFIX="/path/to/1000G_EUR_prefix"
export MSIGDB_KEGG_GMT="/path/to/c2.cp.kegg.v7.5.1.symbols.gmt"
